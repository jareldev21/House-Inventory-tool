{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "redirects": [
    {
      "source": "/",
      "destination": "/HTML/index.html",
      "type": 302
    }
    ]
  }
}


