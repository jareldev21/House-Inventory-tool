rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Access helpers shared by collection rules.
    function signedIn() { return request.auth != null; }
    function validInventoryId(id) { return id.matches('^[a-f0-9]{32}$'); }

    // 2. Private user documents: inventory, shopping list, and connection preference.
    // Personal data and connection preference remain private to their user.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 3. Shared inventory: signed-in ID holders may read/join, members edit categories.
    match /inventories/{id} {
      // An unguessable ID is a sharing code: possessing it allows a signed-in
      // user to read this document and join. Enumeration is never allowed.
      allow get: if signedIn() && validInventoryId(id);
      allow list: if false;
      allow create: if signedIn() && validInventoryId(id)
        && request.resource.data.keys().hasOnly(['ownerId', 'members', 'categories'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.categories is list;
      allow update: if signedIn() && validInventoryId(id) && (
        // Members can change inventory content, never ownership or membership.
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories'])
          && request.resource.data.categories is list)
        ||
        // Joining may append only the caller, keeping every existing member.
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 100
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members)
      );
      allow delete: if false;
    }
  }
}
